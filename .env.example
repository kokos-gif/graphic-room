# 이 파일을 .env 로 복사한 뒤 키를 넣는다. .env 는 제출물에 넣지 않는다.
# 키 발급: https://platform.liner.com/keys  (대회용 $200 크레딧이 들어온 계정에서)
LINER_API_KEY=your-api-key

# 선택. 비우면 liner-gpt-router 를 쓴다.
# 쓸 수 있는 값: liner-gpt-router / liner-claude-router / liner-gemini-router / liner-mark
LINER_MODEL=

# 선택. on 으로 적으면 맞춤 그래픽(메인 · 담당)과 CG Director 를 라우터 대신 anthropic/claude-opus-5.5 로 직접 보낸다.
# 라우터는 그림이 든 물음을 늘 claude-sonnet-5.5 로 보낸다. 직접 지정은 값 약 3배 · 시간 약 2배(11-24 실측) — 안 되면 라우터로 돌아온다.
LINER_DIRECT=

# 선택. 판독 감사(읽은 값을 다른 모델이 의뢰서와 다시 대조)에 쓸 모델.
# 비우면 읽은 모델과 계열이 다른 것을 고른다(읽기 liner-gpt-router → 감사 liner-claude-router).
LINER_AUDIT_MODEL=
# 선택. off 로 적으면 판독 감사를 끈다. 비워 두면 켜져 있다.
MAPCG_AUDIT=
